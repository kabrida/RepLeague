{
  "expo": {
    "name": "RepLeague",
    "slug": "RepLeague",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/RL-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/RL-splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/RL-adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/RL-favicon.png"
    }
  }
}
